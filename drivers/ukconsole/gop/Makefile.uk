$(eval $(call addlib_s,libukconsole_gop,$(CONFIG_LIBUKCONSOLE_GOP)))

LIBUKCONSOLE_GOP_CINCLUDES-y	+= -I$(LIBKVMPLAT_BASE)/include
LIBUKCONSOLE_GOP_CINCLUDES-y	+= -I$(LIBUKCONSOLE_GOP_BASE)/include
LIBUKCONSOLE_GOP_CINCLUDES-y	+= -I$(UK_PLAT_COMMON_BASE)/include
LIBUKCONSOLE_GOP_SRCS-y		+= $(LIBUKCONSOLE_GOP_BASE)/gop.c
LIBUKCONSOLE_GOP_SRCS-y		+= $(LIBUKCONSOLE_GOP_BASE)/font.c
LIBUKCONSOLE_GOP_SRCS-y		+= $(LIBUKCONSOLE_GOP_BASE)/format.c

# Allow efi.c to include <uk/console/gop.h>
CINCLUDES-$(CONFIG_LIBUKCONSOLE_GOP) += -I$(LIBUKCONSOLE_GOP_BASE)/include
